{
  "name": "sher-messenger",
  "version": "0.2.0",
  "description": "SHER Messenger — zero-knowledge encrypted messenger",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/crypto.test.ts tests/storage-audit.test.ts tests/security-audit.test.ts",
    "test:storage": "npx tsx --test tests/storage-audit.test.ts",
    "test:security": "npx tsx --test tests/security-audit.test.ts",
    "gate": "npm audit --production --audit-level=high && npm run lint && npm run typecheck && npm test && npm run build",
    "hash:pw": "npx tsx scripts/hash-pw.ts",
    "setup:auto": "npx tsx scripts/deploy-setup.ts",
    "deploy:oneclick": "npx tsx scripts/deploy-setup.ts --deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.3",
    "next": "^16.3.6",
    "pg": "8.23.0",
    "pg-cloudflare": "^1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wrangler": "^4.136.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
