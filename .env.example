# ═══ SHER-MESSENGER v2 .env.example — (real .env KABHI commit NAHI!) ═══
# 🏷️ BRAND & CORE
PUBLIC_APP_NAME="Sher Messenger"
PUBLIC_UI_LANG_DEFAULT="hi"      # hi | en  (proper bundles — Hinglish NAHI)
APP_NAME="sher-messenger"
BACKEND_TARGET="cf"              # cf | vercel | netlify | deno
DB_TARGET="d1"                   # d1 | neon | turso | supabase  (ops-data ONLY)
ROOM_RUNTIME="do"                # do | upstash | mem-sse (degraded)
STORE_TARGET="r2"                # r2 | b2   (Phase-2 attachments)
NODE_ENV="production"

# 👑 ADMIN — sirf tum! (PocketBase-style: yehi do values panel kholengi)
ADMIN_EMAIL="<tumhara-email@example.com>"
ADMIN_PASSWORD_HASH="<argon2id-hash — generate: `npm run hash:pw -- 'ApkaStrongPassword'` → output yahan>"
ADMIN_PATH="sh3r-9x-admin"       # hidden route; strong+random rakhna!
SESSION_SECRET="<openssl rand -hex 32>"

# 📊 POLICY DEFAULTS (admin panel runtime mein badal sakta)
ROOM_TTL_DEFAULT_MIN="30"        # rooms ki default umar
ROOM_TTL_HARD_CAP_MIN="120"      # isse zyada kabhi nahi (global ceiling)
ROOM_MAX_PARTICIPANTS_DEFAULT="10"
ROOM_MAX_PARTICIPANTS_CAP="50"
ROOM_CREATE_PER_IP_PER_HOUR="5"
CODE_TRY_LIMIT="5"
CODE_LOCK_MIN="15"
WS_MSG_PER_SEC_PER_ROOM="30"
MSG_MAX_BYTES="2048"
ANNOUNCEMENT_TEXT=""             # blank = off
MAINTENANCE_MODE="false"

# ☁️ CLOUDFLARE PRIMARY
CF_ACCOUNT_ID="<CF Account ID>"
CF_API_TOKEN="<token: Workers·Pages·D1·KV·R2 edit>"
D1_DATABASE_ID="<npx wrangler d1 create sher-ops → id>"
KV_NAMESPACE_ID="<npx wrangler kv namespace create sher-rl → id>"

# 🪣 R2 (Phase-2)
R2_ACCOUNT_ID="<CF Account ID>"
R2_ACCESS_KEY_ID="<R2 S3 token>"
R2_SECRET_ACCESS_KEY="<Secret>"
R2_BUCKET="sher-ephemeral"

# 🪣 B2 ALT (PRIVATE ONLY — master-key KABHI NAHI!)
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET="<naya private bucket — dusri apps se ALAG naam>"
B2_KEY_ID="<bucket-specific application-key keyID>"
B2_APPLICATION_KEY="<blue-box applicationKey>"
B2_PRESIGN_PUT_EXPIRY_SEC="300"
B2_PRESIGN_GET_EXPIRY_SEC="120"

# 🐘 NEON ALT
DATABASE_URL="postgres://<user>:<pass>@<host>.neon.tech/sherops?sslmode=require"

# 🌀 TURSO ALT
TURSO_DATABASE_URL="libsql://sherops-<org>.turso.io"
TURSO_AUTH_TOKEN="<JWT>"

# 🟢 SUPABASE ALT
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon>"
SUPABASE_SERVICE_ROLE_KEY="<service_role — server-side only!>"
SUPABASE_DB_URL="postgres://postgres:<pass>@db.<ref>.supabase.co:5432/postgres"

# ⚡ DENO ALT
DENO_DEPLOY_TOKEN="<dash.deno.com token>"

# 🧠 UPSTASH ALT (rooms runtime ALT-A)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 📊 OPS
BUDGET_WARN_PERCENT="80"
HEALTH_TOKEN="<rand32>"
