# ═══════════════════════════════════════════════════════════════════════════════════
# 🦁 SHER-MESSENGER v2 — MASTER .env.example
# ═══════════════════════════════════════════════════════════════════════════════════
# ⚠️ DHYAN DEIN: Ye file public example hai. Isme sabhi FAKE/DUMMY examples diye gaye hain.
# Apna real '.env' file kabhi Git ya public me commit NA karein!
# ═══════════════════════════════════════════════════════════════════════════════════

# ----------------------------------------------------------------------------------
# 🏷️ 1. BRAND & CORE CONFIGURATION
# ----------------------------------------------------------------------------------
# [Kahan milega]: Aapki marzi ka app name aur default bhasha
# [Kaisa dikhega]: Text string ("Sher Messenger", "hi" ya "en")
PUBLIC_APP_NAME="Sher Messenger"
PUBLIC_UI_LANG_DEFAULT="hi"      # 'hi' (Hindi) | 'en' (English)
APP_NAME="sher-messenger"
BACKEND_TARGET="cf"              # 'cf' (Cloudflare) | 'vercel' | 'netlify' | 'deno'
DB_TARGET="d1"                   # 'd1' | 'neon' | 'turso' | 'supabase' (ops/settings only)
ROOM_RUNTIME="do"                # 'do' (Cloudflare Durable Objects) | 'mem-sse'
STORE_TARGET="r2"                # 'r2' | 'b2' (Attachments ke liye)
NODE_ENV="production"

# ----------------------------------------------------------------------------------
# 👑 2. ADMIN CREDENTIALS (Deployer Operator Only)
# ----------------------------------------------------------------------------------
# [Kahan milega]: 
# - ADMIN_EMAIL: Aapka personal email (login ke liye)
# - ADMIN_PASSWORD_HASH: Terminal me run karein: `npm run hash:pw -- "ApkaStrongPassword123!"`
# - ADMIN_PATH: Aapka secret hidden URL route (default /sh3r-9x-admin)
# - SESSION_SECRET: Terminal me run karein: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# [Kaisa dikhega]:
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD_HASH="$pbkdf2-sha256$i=250000$example_salt_32_chars$example_hash_64_chars"
ADMIN_PATH="sh3r-9x-admin"
SESSION_SECRET="example_32_byte_session_secret_hex_string"

# ----------------------------------------------------------------------------------
# 📊 3. POLICY MATRIX & DEFAULTS
# ----------------------------------------------------------------------------------
# [Kahan milega]: Admin panel (/sh3r-9x-admin) se runtime me bhi badal sakte hain
# [Kaisa dikhega]: Numbers (Minutes, limits)
ROOM_TTL_DEFAULT_MIN="30"        # Default room duration (Minutes)
ROOM_TTL_HARD_CAP_MIN="120"      # Maximum room duration limit (Minutes)
ROOM_MAX_PARTICIPANTS_DEFAULT="10"
ROOM_MAX_PARTICIPANTS_CAP="50"
ROOM_CREATE_PER_IP_PER_HOUR="5"  # 1 IP se 1 ghante me kitne rooms ban sakte hain
CODE_TRY_LIMIT="5"               # Wrong code attempts before lockout
CODE_LOCK_MIN="15"               # Lockout duration (Minutes)
WS_MSG_PER_SEC_PER_ROOM="30"     # Anti-spam message flood limit
MSG_MAX_BYTES="2048"             # Max message size (2KB per frame)
ANNOUNCEMENT_TEXT=""             # Global broadcast message (blank = off)
MAINTENANCE_MODE="false"

# ----------------------------------------------------------------------------------
# ☁️ 4. CLOUDFLARE INFRASTRUCTURE (₹0 Free Tier)
# ----------------------------------------------------------------------------------
# [Kahan milega]:
# - CF_ACCOUNT_ID: Cloudflare Dashboard -> Right Sidebar -> Account ID
# - CF_API_TOKEN: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token (Workers, D1, KV Edit)
# - D1_DATABASE_ID: Terminal me run karein: `npx wrangler d1 create sher-ops`
# - KV_NAMESPACE_ID: Terminal me run karein: `npx wrangler kv namespace create sher-rl`
# [Kaisa dikhega]:
CF_ACCOUNT_ID="your_cf_account_id_32_chars_hex"
CF_API_TOKEN="your_cf_custom_api_token_here"
D1_DATABASE_ID="00000000-0000-0000-0000-000000000000"
KV_NAMESPACE_ID="your_kv_namespace_id_32_chars_hex"

# ----------------------------------------------------------------------------------
# 🪣 5. CLOUDFLARE R2 STORAGE (Attachments ke liye)
# ----------------------------------------------------------------------------------
# [Kahan milega]: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# [Kaisa dikhega]:
R2_ACCOUNT_ID="your_cf_account_id_32_chars_hex"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET="sher-ephemeral-media"

# ----------------------------------------------------------------------------------
# 🪣 6. BACKBLAZE B2 STORAGE (Alternative Private S3 Bucket)
# ----------------------------------------------------------------------------------
# [Kahan milega]: Backblaze B2 Console -> App Keys -> Add a New Application Key (Read/Write)
# [Kaisa dikhega]:
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET="sher-ephemeral-private"
B2_KEY_ID="your_b2_key_id_here"
B2_APPLICATION_KEY="your_b2_application_key_here"
B2_PRESIGN_PUT_EXPIRY_SEC="300"
B2_PRESIGN_GET_EXPIRY_SEC="120"

# ----------------------------------------------------------------------------------
# 🐘 7. ALTERNATIVE SQL DATABASES (Neon / Turso / Supabase)
# ----------------------------------------------------------------------------------
# [Kahan milega]:
# - Neon: https://console.neon.tech -> Dashboard -> Connection String (-pooler URL)
# - Turso: https://turso.tech -> `turso db show <name>` -> Database URL + Auth Token
# - Supabase: https://supabase.com -> Project Settings -> Database -> Connection URL
# [Kaisa dikhega]:
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/sherops?sslmode=require"
TURSO_DATABASE_URL="libsql://sherops-sample.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_jwt"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_jwt"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_jwt"

# ----------------------------------------------------------------------------------
# 📈 8. OPTIONAL PRIVACY-RESPECTING ANALYTICS (Leave blank for 0-telemetry)
# ----------------------------------------------------------------------------------
# 1. MeraAnalytics / Umami Script:
#    [Kahan milega]: MeraAnalytics Dashboard -> Settings -> Websites -> Tracking Code (Script URL & Website ID)
#    [Kaisa dikhega]:
#    NEXT_PUBLIC_MERA_ANALYTICS_SRC="https://analystic-2u7p.onrender.com/mera-analytics.js"
#    NEXT_PUBLIC_MERA_ANALYTICS_ID="53bb2503-d3ae-4427-9767-7d8458d88fe1"
NEXT_PUBLIC_MERA_ANALYTICS_SRC=""
NEXT_PUBLIC_MERA_ANALYTICS_ID=""

# 2. PrismAnalytics Cloudflare Worker:
#    [Kahan milega]: Aapka Prism Worker Dashboard -> Site ID (`pa_...`) aur Worker Track URL
#    [Kaisa dikhega]:
#    NEXT_PUBLIC_PRISM_ANALYTICS_ID="pa_f5205d1f3fe04a89aa18"
#    NEXT_PUBLIC_PRISM_ANALYTICS_URL="https://prismanalytics.sudhirdevops1.workers.dev/api/track"
NEXT_PUBLIC_PRISM_ANALYTICS_ID=""
NEXT_PUBLIC_PRISM_ANALYTICS_URL=""

# ----------------------------------------------------------------------------------
# 📬 9. FEEDBACK & CONTACT FORM ENDPOINT (Leave blank to disable)
# ----------------------------------------------------------------------------------
# [Kahan milega]: ApnaForm Worker / Formspree / Custom Form Submit URL
# [Kaisa dikhega]:
# NEXT_PUBLIC_CONTACT_FORM_ACTION="https://apnaform.sudhirdevops1.workers.dev/api/submit/endpoint_H2b3ggdw_8bmrWoND0K1lifu"
NEXT_PUBLIC_CONTACT_FORM_ACTION=""

