# ─────────────────────────────────────────────────────────────────────────────
# KED VAULT — environment
# Copy to .env and fill ONLY what you need. Everything empty ⇒ volatile
# in-memory relay (perfect for evaluating the protocol; data dies on restart).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database adapter (pick ONE) ───────────────────────────────────────────────
# Selection order: SHER_DB override → SHER_SQLITE_PATH → TURSO_URL → DATABASE_URL → memory

# Postgres family: Neon, Supabase, RDS, local. Node runtimes (needs TCP).
# Neon tip: use the -pooler connection string on serverless to avoid connection exhaustion.
DATABASE_URL=
# POSTGRES_URL=
# NEON_DATABASE_URL=

# Turso / libSQL over HTTP — the only DB that works on edge runtimes (CF Workers, Vercel/Netlify Edge)
TURSO_URL=
TURSO_TOKEN=
# LIBSQL_URL=
# LIBSQL_TOKEN=

# File-backed SQLite via node:sqlite — best for VPS/Docker, zero native deps
SHER_SQLITE_PATH=

# Force an adapter: memory | postgres | turso | sqlite
SHER_DB=

# ── Host / backend target ─────────────────────────────────────────────────────
# node | workers | netlify   (selects how the relay router is hosted; same handler shape)
BACKEND_TARGET=node
# r2 | b2 | inline          (attachment blob destination; inline = base64 in the row)
STORE_TARGET=inline
# postgres | libsql | d1 | sqlite | memory   (informational, for /api/ked/version)
DB_TARGET=

# ── Access control ────────────────────────────────────────────────────────────
# "1" (default) = signup requires a valid invite code from /admin → Invites.
# "0" = open registration. ONLY use 0 for a local sandbox or the first bootstrap.
SHER_INVITE_ONLY=1

# ── Operations ────────────────────────────────────────────────────────────────
# "on" (default) = per-route token buckets + 6-strike lockout. NEVER turn off in
# production. "off" exists for CI / load tests where every run shares one IP.
SHER_RATE_LIMIT=on
# Shown by GET /api/ked/version; set to the git SHA in CI for a real build stamp
SHER_BUILD_HASH=dev
# Set to "1" to shed load: relay answers 503 JSON everywhere except /healthz
SHER_MAINTENANCE=
# Where incident reports go; surfaced in /privacy and SECURITY.md
OPERATOR_EMAIL=you@example.com
# If the relay lives on a different origin than the static shell
SHER_RELAY_URL=
NEXT_PUBLIC_APP_NAME=KED Vault

# ── Storage adapter secrets (only if STORE_TARGET=r2|b2) ──────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# ── Admin panel (env-only gate, not linked publicly) ──────────────────────────
# Web stays open for users; /admin requires BOTH env credentials + an admin invite bearer token.
# Set these as Encrypted secrets on Cloudflare/Vercel/Render. Web never exposes them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SHER_ADMIN_EMAIL=
# SHER_ADMIN_PASSWORD=

# ── Web Push (VAPID). Payloads are WAKE-UP ONLY: no content, no sender name. ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Backward compatibility ────────────────────────────────────────────────────
# Existing deployments may keep KED_DB, KED_SQLITE_PATH, KED_INVITE_ONLY,
# KED_RATE_LIMIT, KED_MAINTENANCE and KED_BUILD_HASH. SHER_* takes precedence;
# old variables remain accepted so upgrading never breaks an encrypted vault.
